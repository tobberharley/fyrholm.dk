---
import { Picture } from 'astro:assets';
import heroImgSrc from '../assets/images/fyrholm-cfmoller.jpg';
import site from '../data/site.json';
import { link } from '../lib/url';

const heroImageAlt = (site as any).heroImageAlt as string | undefined;
const heroCredit = (site as any).heroCredit as string | undefined;
---

<section class="hero" aria-label="Fyrholm set fra havneløbet">
  <Picture
    class="hero-bg"
    src={heroImgSrc}
    alt={heroImageAlt ?? ''}
    widths={[640, 1024, 1440, 1800]}
    formats={['avif', 'webp']}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="hero-text">
      <span class="eyebrow">EJERFORENINGEN FYRHOLM</span>
      <h1><span>{site.hero.heading}</span></h1>
      <p class="lead"><span>{site.hero.body}</span></p>
      <div class="hero-actions">
        <a href={link(site.hero.ctaLink)} class="btn">{site.hero.ctaText}</a>
        <a href={link('/nyheder')} class="btn btn-light">Seneste nyheder</a>
      </div>
    </div>
  </div>
  {heroCredit && <p class="hero-credit">{heroCredit}</p>}
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    width: 100%;
    height: clamp(624px, 72vw, 912px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--color-accent);
    color: #fff;
    border-bottom: 1px solid var(--color-border);
  }

  /* hero-bg is the <img> from <Picture /> — make it fill the hero */
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    display: block;
    object-fit: cover;
    /* Fasthold 25 % af midterlinjen synlig ved resize. */
    object-position: center 25%;
  }

  /* Subtil gradient kun nederst — bygningen skal bære */
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      rgba(15, 28, 38, 0.70) 0%,
      rgba(15, 28, 38, 0.35) 25%,
      rgba(15, 28, 38, 0.05) 50%,
      rgba(15, 28, 38, 0) 65%
    );
  }

  .hero-inner {
    width: 100%;
    padding-top: var(--space-6);
    padding-bottom: var(--space-8);
  }

  .hero-text {
    max-width: 100ch;
  }

  .hero h1 {
    color: #fff;
    margin-bottom: var(--space-3);
    font-size: clamp(2rem, 3vw + 1rem, 3.25rem);
    letter-spacing: -0.02em;
    line-height: 1.35;
    text-wrap: balance;
  }
  .hero h1 > span,
  .lead > span {
    background: rgba(15, 28, 38, 0.55);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    padding: 0.05em 0.35em;
    border-radius: 4px;
  }

  .hero .eyebrow {
    color: rgba(255, 255, 255, 0.95);
    background: rgba(15, 28, 38, 0.55);
    padding: 0.15em 0.6em;
    border-radius: 4px;
  }

  .lead {
    color: #fff;
    font-size: 1.15rem;
    max-width: 92ch;
    margin-bottom: 0;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  .btn-light {
    background: rgba(255, 255, 255, 0.95);
    color: var(--color-accent);
    border-color: rgba(255, 255, 255, 0.95);
  }
  .btn-light:hover,
  .btn-light:focus-visible {
    background: #fff;
    border-color: #fff;
    color: var(--color-accent-hover);
  }

  .hero-credit {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-5);
    margin: 0;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.7);
    letter-spacing: 0.04em;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
  }

  @media (max-width: 640px) {
    .hero { height: clamp(576px, 132vw, 816px); }
    .hero-inner { padding-bottom: var(--space-6); }
    .hero-overlay {
      background: linear-gradient(
        to top,
        rgba(15, 28, 38, 0.80) 0%,
        rgba(15, 28, 38, 0.55) 35%,
        rgba(15, 28, 38, 0.15) 65%,
        rgba(15, 28, 38, 0) 85%
      );
    }
    .hero-credit { right: var(--space-3); font-size: 0.68rem; }
    .lead { font-size: 1rem; }
  }
</style>
