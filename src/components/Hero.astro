---
import site from '../data/site.json';
import { link } from '../lib/url';

const heroImage = (site as any).heroImage as string | undefined;
const heroImageAlt = (site as any).heroImageAlt as string | undefined;
const heroCredit = (site as any).heroCredit as string | undefined;
---

<section class="hero" aria-label="Fyrholm set fra havneløbet">
  {heroImage && (
    <img
      class="hero-bg"
      src={link(heroImage)}
      alt={heroImageAlt ?? ''}
      loading="eager"
      fetchpriority="high"
    />
  )}
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="hero-text">
      <span class="eyebrow">Velkommen</span>
      <h1>{site.hero.heading}</h1>
      <p class="lead">{site.hero.body}</p>
      <div class="hero-actions">
        <a href={link(site.hero.ctaLink)} class="btn">{site.hero.ctaText}</a>
        <a href={link('/nyheder')} class="btn btn-light">Seneste nyheder</a>
      </div>
      <form class="hero-search" role="search" action={link('/sog')} method="get">
        <label for="hero-q" class="sr-only">Søg</label>
        <input id="hero-q" type="search" name="q" placeholder="Søg på siden…" autocomplete="off" />
        <button type="submit" class="btn">Søg</button>
      </form>
    </div>
  </div>
  {heroCredit && <p class="hero-credit">{heroCredit}</p>}
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: clamp(560px, 82vh, 820px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--color-accent);
    color: #fff;
    border-bottom: 1px solid var(--color-border);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
    z-index: -2;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to top,
      rgba(15, 28, 38, 0.78) 0%,
      rgba(15, 28, 38, 0.55) 28%,
      rgba(15, 28, 38, 0.10) 55%,
      rgba(15, 28, 38, 0) 75%
    );
  }

  .hero-inner {
    width: 100%;
    padding-top: var(--space-5);
    padding-bottom: var(--space-7);
  }

  .hero-text {
    max-width: 56ch;
  }

  .hero h1 {
    color: #fff;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.35);
    margin-bottom: var(--space-4);
  }

  .hero .eyebrow {
    color: rgba(255, 255, 255, 0.85);
  }

  .lead {
    color: rgba(255, 255, 255, 0.92);
    font-size: 1.1rem;
    max-width: 56ch;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.25);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-5) 0 var(--space-5);
  }

  .btn-light {
    background: rgba(255, 255, 255, 0.95);
    color: var(--color-accent);
    border-color: rgba(255, 255, 255, 0.95);
  }
  .btn-light:hover,
  .btn-light:focus-visible {
    background: #fff;
    border-color: #fff;
    color: var(--color-accent-hover);
  }

  .hero-search {
    display: flex;
    gap: var(--space-2);
    background: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: var(--radius-sm);
    padding: var(--space-2);
    max-width: 480px;
  }

  .hero-search input {
    flex: 1;
    border: 0;
    background: transparent;
    padding: 0 var(--space-3);
    font: inherit;
    color: var(--color-text);
  }

  .hero-search input:focus { outline: none; }

  .hero-search .btn {
    padding: 0.55rem 1.1rem;
  }

  .hero-credit {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-5);
    margin: 0;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.7);
    letter-spacing: 0.04em;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .hero { min-height: 540px; }
    .hero-credit { right: var(--space-3); font-size: 0.7rem; }
  }
</style>
