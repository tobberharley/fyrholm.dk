---
import site from '../data/site.json';
import { link } from '../lib/url';

const heroImage = (site as any).heroImage as string | undefined;
const heroImageAlt = (site as any).heroImageAlt as string | undefined;
const heroCredit = (site as any).heroCredit as string | undefined;
---

<section class="hero" aria-label="Fyrholm set fra havneløbet">
  <div class="hero-stage">
    {heroImage && (
      <img
        class="hero-bg"
        src={link(heroImage)}
        alt={heroImageAlt ?? ''}
        loading="eager"
        fetchpriority="high"
      />
    )}
    <div class="hero-fade" aria-hidden="true"></div>

    <div class="container hero-inner">
      <div class="hero-card">
        <span class="eyebrow">Velkommen</span>
        <h1>{site.hero.heading}</h1>
        <span class="hero-rule" aria-hidden="true"></span>
        <p class="lead">{site.hero.body}</p>
        <div class="hero-actions">
          <a href={link(site.hero.ctaLink)} class="btn">{site.hero.ctaText}</a>
          <a href={link('/nyheder')} class="hero-link">Seneste nyheder →</a>
        </div>
      </div>
    </div>

    {heroCredit && <p class="hero-credit">{heroCredit}</p>}
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--color-bg-soft, #f6f1ea);
    padding: clamp(var(--space-3), 2vw, var(--space-5));
    border-bottom: 1px solid var(--color-border);
  }

  /* Selve "scenen" — billedet er ramme og scene for kortet */
  .hero-stage {
    position: relative;
    width: 100%;
    min-height: clamp(520px, 78vh, 760px);
    overflow: hidden;
    border-radius: clamp(8px, 1vw, 18px);
    display: flex;
    align-items: flex-end;
    background: var(--color-accent);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    z-index: 0;
  }

  /* Blød fade kun nederst, så kortet får et godt fundament uden at bygningen forsvinder */
  .hero-fade {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to top,
      rgba(15, 28, 38, 0.55) 0%,
      rgba(15, 28, 38, 0.18) 30%,
      rgba(15, 28, 38, 0) 55%
    );
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: var(--space-5);
  }

  /* Kortet — let frostet glas, så bygningen anes igennem */
  .hero-card {
    max-width: 36rem;
    padding: clamp(var(--space-5), 2.5vw, var(--space-6));
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px) saturate(110%);
    -webkit-backdrop-filter: blur(8px) saturate(110%);
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: clamp(6px, 0.6vw, 10px);
    box-shadow:
      0 1px 2px rgba(15, 28, 38, 0.08),
      0 24px 48px -20px rgba(15, 28, 38, 0.35);
  }

  .hero-card .eyebrow {
    color: var(--color-accent);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    font-weight: 600;
  }

  .hero-card h1 {
    margin: var(--space-2) 0 var(--space-3);
    font-size: clamp(1.85rem, 2.2vw + 1rem, 2.75rem);
    letter-spacing: -0.02em;
    line-height: 1.08;
    color: var(--color-text, #0f1c26);
  }

  /* Tynd linje i accentfarve — diskret, "magasin"-detalje */
  .hero-rule {
    display: block;
    width: 56px;
    height: 2px;
    background: var(--color-accent);
    margin: 0 0 var(--space-4);
  }

  .hero-card .lead {
    color: var(--color-text-muted, #4a5662);
    font-size: 1.05rem;
    line-height: 1.55;
    max-width: 48ch;
    margin: 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    margin-top: var(--space-5);
  }

  .hero-link {
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.18s ease;
  }
  .hero-link:hover,
  .hero-link:focus-visible {
    border-bottom-color: currentColor;
  }

  .hero-credit {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-4);
    margin: 0;
    z-index: 2;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.85);
    letter-spacing: 0.04em;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }

  @media (max-width: 640px) {
    .hero { padding: 0; }
    .hero-stage {
      min-height: 540px;
      border-radius: 0;
      align-items: flex-end;
    }
    .hero-inner { padding: var(--space-4); }
    .hero-card { padding: var(--space-5); }
    .hero-card .lead { font-size: 1rem; }
    .hero-credit { right: var(--space-3); font-size: 0.66rem; }
  }
</style>


