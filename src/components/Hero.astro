---
import site from '../data/site.json';
import { link } from '../lib/url';

const heroImage = (site as any).heroImage as string | undefined;
const heroImageAlt = (site as any).heroImageAlt as string | undefined;
const heroCredit = (site as any).heroCredit as string | undefined;
---

<section class="hero" aria-label="Fyrholm set fra havneløbet">
  {heroImage && (
    <img
      class="hero-bg"
      src={link(heroImage)}
      alt={heroImageAlt ?? ''}
      loading="eager"
      fetchpriority="high"
    />
  )}
  <div class="hero-overlay" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-text">
      <span class="eyebrow">Velkommen</span>
      <h1>{site.hero.heading}</h1>
      <p class="lead">{site.hero.body}</p>
      <div class="hero-actions">
        <a href={link(site.hero.ctaLink)} class="btn">{site.hero.ctaText}</a>
        <a href={link('/nyheder')} class="btn btn-light">Seneste nyheder</a>
      </div>
    </div>
  </div>

  {heroCredit && <p class="hero-credit">{heroCredit}</p>}
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: clamp(560px, 80vh, 800px);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    background: var(--color-accent);
    color: #fff;
    border-bottom: 1px solid var(--color-border);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 42%;
    z-index: -2;
  }

  /* Jævn, blød fade så bygningen anes hele vejen, men teksten har ro bagved */
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        ellipse at center,
        rgba(15, 28, 38, 0.55) 0%,
        rgba(15, 28, 38, 0.40) 40%,
        rgba(15, 28, 38, 0.30) 70%,
        rgba(15, 28, 38, 0.40) 100%
      );
  }

  .hero-inner {
    width: 100%;
    padding: var(--space-7) var(--space-4);
  }

  .hero-text {
    max-width: 56ch;
    margin: 0 auto;
    /* Kontrast-skygge: blød, bred mørk halo bag teksten — diskret men effektiv */
    filter: drop-shadow(0 2px 18px rgba(0, 0, 0, 0.45));
  }

  .hero .eyebrow {
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    font-weight: 600;
    text-transform: uppercase;
  }

  .hero h1 {
    color: #fff;
    margin: var(--space-3) 0 var(--space-3);
    font-size: clamp(2.1rem, 3vw + 1rem, 3.4rem);
    letter-spacing: -0.02em;
    line-height: 1.08;
  }

  .lead {
    color: rgba(255, 255, 255, 0.96);
    font-size: clamp(1.05rem, 0.4vw + 1rem, 1.2rem);
    line-height: 1.55;
    max-width: 52ch;
    margin: 0 auto;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
    justify-content: center;
  }

  .btn-light {
    background: rgba(255, 255, 255, 0.95);
    color: var(--color-accent);
    border-color: rgba(255, 255, 255, 0.95);
  }
  .btn-light:hover,
  .btn-light:focus-visible {
    background: #fff;
    border-color: #fff;
    color: var(--color-accent-hover);
  }

  .hero-credit {
    position: absolute;
    bottom: var(--space-3);
    right: var(--space-5);
    margin: 0;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.75);
    letter-spacing: 0.04em;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }

  @media (max-width: 640px) {
    .hero { min-height: 540px; }
    .hero-inner { padding: var(--space-6) var(--space-4); }
    .hero-credit { right: var(--space-3); font-size: 0.66rem; }
    .lead { font-size: 1rem; }
  }
</style>



