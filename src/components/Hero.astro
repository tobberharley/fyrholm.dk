---
import site from '../data/site.json';
import { link } from '../lib/url';

const heroImage = (site as any).heroImage as string | undefined;
const heroImageAlt = (site as any).heroImageAlt as string | undefined;
const heroCredit = (site as any).heroCredit as string | undefined;
---

<section class="hero" aria-label="Fyrholm set fra havneløbet">
  <div class="hero-media">
    {heroImage && (
      <img
        class="hero-bg"
        src={link(heroImage)}
        alt={heroImageAlt ?? ''}
        loading="eager"
        fetchpriority="high"
      />
    )}
    {heroCredit && <p class="hero-credit">{heroCredit}</p>}
  </div>
  <div class="container hero-panel-wrap">
    <div class="hero-panel">
      <span class="eyebrow">Velkommen</span>
      <h1>{site.hero.heading}</h1>
      <p class="lead">{site.hero.body}</p>
      <div class="hero-actions">
        <a href={link(site.hero.ctaLink)} class="btn">{site.hero.ctaText}</a>
        <a href={link('/nyheder')} class="btn btn-secondary">Seneste nyheder</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--color-bg, #fff);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-7);
  }

  .hero-media {
    position: relative;
    width: 100%;
    aspect-ratio: 21 / 9;
    overflow: hidden;
    background: var(--color-accent);
  }

  /* På små skærme bliver billedet højere så motivet ikke beskæres for hårdt */
  @media (max-width: 640px) {
    .hero-media { aspect-ratio: 4 / 3; }
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 45%;
    display: block;
  }

  .hero-credit {
    position: absolute;
    bottom: var(--space-2);
    right: var(--space-4);
    margin: 0;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.85);
    letter-spacing: 0.04em;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
  }

  /* Panelet "lapper over" billedet — postkort-look */
  .hero-panel-wrap {
    margin-top: calc(var(--space-7) * -1);
    position: relative;
    z-index: 2;
  }

  .hero-panel {
    background: #fff;
    padding: clamp(var(--space-5), 4vw, var(--space-7));
    border-radius: var(--radius-lg, 14px);
    box-shadow:
      0 1px 2px rgba(15, 28, 38, 0.06),
      0 12px 32px -12px rgba(15, 28, 38, 0.18);
    max-width: 56rem;
  }

  .hero-panel h1 {
    margin: var(--space-2) 0 var(--space-3);
    font-size: clamp(1.85rem, 2.4vw + 1rem, 2.85rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .hero-panel .eyebrow {
    color: var(--color-accent);
  }

  .hero-panel .lead {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    max-width: 56ch;
    margin: 0;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }

  @media (max-width: 640px) {
    .hero-panel-wrap { margin-top: calc(var(--space-6) * -1); }
    .hero-panel { padding: var(--space-5); }
    .hero-panel .lead { font-size: 1rem; }
    .hero-credit { right: var(--space-3); font-size: 0.68rem; }
  }
</style>

