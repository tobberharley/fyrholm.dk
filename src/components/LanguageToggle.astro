---
// Language toggle that swaps between the Danish site and the
// pre-translated English mirror under /en/.
import { base } from '../lib/url';
---

<a
  id="lang-toggle"
  class="lang-toggle notranslate"
  translate="no"
  data-base={base || '/'}
  href="#"
>
  <span aria-hidden="true">EN</span>
</a>

<style>
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    height: 32px;
    padding: 0 10px;
    border: 1px solid var(--color-border-strong, var(--color-border));
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-text);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .lang-toggle:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    text-decoration: none;
  }
  .lang-toggle[data-state='en'] {
    background: var(--color-accent);
    color: var(--color-on-accent, #fff);
    border-color: var(--color-accent);
  }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById('lang-toggle');
    if (!btn) return;
    var base = (btn.getAttribute('data-base') || '/').replace(/\/$/, '');
    var path = location.pathname;
    var enPrefix = base + '/en';
    var isEn = path === enPrefix || path.indexOf(enPrefix + '/') === 0;

    if (isEn) {
      btn.setAttribute('data-state', 'en');
      btn.firstElementChild.textContent = 'DA';
      btn.setAttribute('aria-label', 'Vis siden på dansk');
      var rest = path.slice(enPrefix.length) || '/';
      btn.setAttribute('href', base + rest + location.search + location.hash);
    } else {
      btn.setAttribute('data-state', 'da');
      btn.firstElementChild.textContent = 'EN';
      btn.setAttribute('aria-label', 'Translate to English');
      var rel = base ? path.replace(new RegExp('^' + base.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')), '') : path;
      if (!rel.startsWith('/')) rel = '/' + rel;
      btn.setAttribute('href', base + '/en' + rel + location.search + location.hash);
    }
  })();
</script>
