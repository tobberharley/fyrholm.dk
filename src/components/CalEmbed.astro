---
import site from '../data/site.json';

interface Props {
  calLink?: string; // e.g. "fyrholm/orangeri"
  height?: string;
  origin?: string; // e.g. "https://cal.eu" or "https://app.cal.com"
}

const cal = (site as any).calcom as { username?: string; eventSlug?: string; origin?: string } | undefined;
const calLink = Astro.props.calLink ?? (cal?.username && cal?.eventSlug ? `${cal.username}/${cal.eventSlug}` : undefined);
const height = Astro.props.height ?? '720px';
const origin = Astro.props.origin ?? cal?.origin ?? 'https://cal.com';
const embedSrc = `${origin}/embed/embed.js`;
---

{calLink ? (
  <div class="cal-embed-wrap">
    <div id="cal-inline" style={`min-width:320px;width:100%;height:${height};overflow:scroll`} aria-label="Booking-kalender"></div>

    <script is:inline define:vars={{ calLink, embedSrc, origin }}>
      (function (C, A, L) {
        let p = function (a, ar) { a.q.push(ar); };
        let d = C.document;
        C.Cal = C.Cal || function () {
          let cal = C.Cal;
          let ar = arguments;
          if (!cal.loaded) {
            cal.ns = {};
            cal.q = cal.q || [];
            d.head.appendChild(d.createElement("script")).src = A;
            cal.loaded = true;
          }
          if (ar[0] === L) {
            const api = function () { p(api, arguments); };
            const namespace = ar[1];
            api.q = api.q || [];
            if (typeof namespace === "string") {
              cal.ns[namespace] = cal.ns[namespace] || api;
              p(cal.ns[namespace], ar);
              p(cal, ["initNamespace", namespace]);
            } else { p(cal, ar); }
            return;
          }
          p(cal, ar);
        };
      })(window, embedSrc, "init");

      Cal("init", "orangeri", { origin: origin });

      Cal.ns.orangeri("inline", {
        elementOrSelector: "#cal-inline",
        config: { layout: "month_view", theme: "light" },
        calLink: calLink,
      });

      Cal.ns.orangeri("ui", {
        hideEventTypeDetails: false,
        layout: "month_view",
      });
    </script>
  </div>
) : (
  <div class="cal-embed-placeholder">
    <p>Booking-kalenderen er ikke konfigureret endnu. Tilføj <code>calcom.username</code> og <code>calcom.eventSlug</code> i <code>src/data/site.json</code>.</p>
  </div>
)}

<style>
  .cal-embed-wrap {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    background: var(--color-bg);
  }
  .cal-embed-placeholder {
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    background: var(--color-bg-soft);
    color: var(--color-text-muted);
  }
  .cal-embed-placeholder code {
    background: var(--color-bg);
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-sm);
    font-size: 0.9em;
  }
</style>
