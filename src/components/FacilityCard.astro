---
import type { CollectionEntry } from 'astro:content';
import { link } from '../lib/url';

interface Props {
  entry: CollectionEntry<'facilities'>;
}

const { entry } = Astro.props;
const isExternal = !!entry.data.link;
const href = isExternal ? entry.data.link! : link(`/faciliteter/${entry.id}`);
---

<a class="facility-card card" href={href} {...isExternal ? { target: '_blank', rel: 'noopener' } : {}}>
  <div class="facility-icon" aria-hidden="true">{entry.data.icon}</div>
  <div class="facility-body">
    <h3>
      {entry.data.title}
      {entry.data.badge && <span class="badge" title={entry.data.badge}>{entry.data.badge}</span>}
      {entry.data.membersOnly && <span class="badge" title="Kræver medlemskab">Medlemskab</span>}
    </h3>
    <p>{entry.data.summary}</p>
    <span class="facility-link">
      {isExternal ? 'Åbn link →' : 'Læs mere →'}
    </span>
  </div>
</a>

<style>
  .facility-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .facility-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-accent);
    text-decoration: none;
  }
  .facility-icon {
    font-size: 2rem;
    line-height: 1;
    width: 3rem;
    height: 3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    background: var(--color-accent-soft, var(--color-bg-soft));
  }
  .facility-body h3 {
    margin: 0 0 var(--space-2);
    font-size: 1.2rem;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .facility-body p {
    margin: 0 0 var(--space-3);
    color: var(--color-text-muted);
  }
  .facility-link {
    font-weight: 600;
    color: var(--color-accent);
    margin-top: auto;
  }
  .badge {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: var(--color-bg-soft);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
  }
</style>
