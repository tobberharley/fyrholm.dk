---
import type { CollectionEntry } from 'astro:content';
import { link } from '../lib/url';

interface Props {
  events: CollectionEntry<'events'>[];
}

const { events } = Astro.props;
const fmt = new Intl.DateTimeFormat('da-DK', {
  day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit',
});
---

{events.length === 0 ? (
  <p class="empty">Ingen kommende begivenheder lige nu. Kig forbi igen senere!</p>
) : (
  <ul class="event-list">
    {events.map((e) => (
      <li class="event">
        <div class="event-date">
          <span class="day">{e.data.date.getDate()}</span>
          <span class="month">{e.data.date.toLocaleDateString('da-DK', { month: 'short' })}</span>
        </div>
        <div class="event-body">
          <h3>{e.data.title}</h3>
          <p class="meta">
            {fmt.format(e.data.date)}
            {e.data.location && <> · {e.data.location}</>}
          </p>
          {e.data.summary && <p>{e.data.summary}</p>}
          <a class="event-add" href={link(`/kalender/${e.id.replace(/\.md$/, '')}.ics`)} download>
            <span aria-hidden="true">📅</span> Tilføj til kalender
          </a>
        </div>
      </li>
    ))}
  </ul>
)}

<style>
  .event-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .event {
    display: flex;
    gap: var(--space-5);
    align-items: stretch;
    padding: var(--space-4) var(--space-5);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .event-date {
    flex: 0 0 64px;
    text-align: center;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-2);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .event-date .day {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1;
  }

  .event-date .month {
    text-transform: uppercase;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    margin-top: 4px;
  }

  .event-body h3 {
    margin: 0 0 var(--space-1);
    font-size: 1.1rem;
  }

  .meta {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin: 0 0 var(--space-2);
  }

  .empty {
    color: var(--color-text-muted);
    font-style: italic;
  }

  .event-add {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: var(--space-2);
    font-size: 0.85rem;
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .event-add:hover,
  .event-add:focus-visible {
    border-bottom-color: var(--color-accent);
  }
</style>
