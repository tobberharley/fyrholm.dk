---
import site from '../data/site.json';
import { link, base } from '../lib/url';
import LanguageToggle from './LanguageToggle.astro';

const navItems = [
  { label: 'Nyheder', href: '/nyheder' },
  { label: 'Det sker', href: '/kalender' },
  { label: 'Faciliteter', href: '/faciliteter' },
  { label: 'Godt at vide', href: '/viden' },
  { label: 'Ejerforeningen', href: '/ejerforeningen' },
  { label: 'Om os', href: '/om-os' },
  { label: 'Historie', href: '/historie' },
  { label: 'Kontakt', href: '/kontakt' },
];

const rawPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const pathname = base && rawPath.startsWith(base) ? rawPath.slice(base.length) || '/' : rawPath;
---

<header class="site-header">
  <div class="container header-inner">
    <a href={link('/')} class="logo" aria-label={`${site.name} forside`}>
      <span class="logo-text">{site.shortName}</span>
    </a>
    <button class="nav-toggle" aria-label="Åbn menu" aria-expanded="false" aria-controls="primary-nav">
      <span></span><span></span><span></span>
    </button>
    <nav id="primary-nav" class="primary-nav" aria-label="Primær">
      <ul>
        {navItems.map((item) => {
          const active = pathname === item.href || (item.href !== '/' && pathname.startsWith(item.href));
          return (
            <li>
              <a href={link(item.href)} aria-current={active ? 'page' : undefined}>{item.label}</a>
            </li>
          );
        })}
      </ul>
    </nav>
    <div class="header-actions">
      <form class="header-search" role="search" action={link('/sog')} method="get">
        <label class="visually-hidden" for="header-search-input">Søg</label>
        <svg class="header-search-icon" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input id="header-search-input" type="search" name="q" placeholder="Søg…" autocomplete="off" />
      </form>
      <a href={link('/sog')} class="header-search-link" aria-label="Søg">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </a>
      <LanguageToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(248, 246, 241, 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-left: var(--space-3);
  }

  .header-search {
    position: relative;
    display: flex;
    align-items: center;
  }
  .header-search-icon {
    position: absolute;
    left: 10px;
    color: var(--color-text-muted);
    pointer-events: none;
  }
  .header-search input[type='search'] {
    appearance: none;
    -webkit-appearance: none;
    border: 1px solid var(--color-border);
    background: rgba(255, 255, 255, 0.7);
    border-radius: 999px;
    font: inherit;
    font-size: 0.9rem;
    padding: 0.4rem 0.8rem 0.4rem 2rem;
    width: 14rem;
    color: var(--color-text);
    transition: border-color 0.15s ease, background 0.15s ease, width 0.2s ease;
  }
  .header-search input[type='search']:focus {
    outline: none;
    border-color: var(--color-accent);
    background: #fff;
  }
  .header-search input[type='search']::-webkit-search-cancel-button { cursor: pointer; }

  .header-search-link {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--color-text);
    border-radius: 999px;
  }
  .header-search-link:hover { background: rgba(0,0,0,0.05); text-decoration: none; }

  .visually-hidden {
    position: absolute !important;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0);
    white-space: nowrap; border: 0;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--color-text);
    font-weight: 600;
    font-size: 1.1rem;
  }

  .logo:hover { text-decoration: none; }

  .logo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .primary-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--space-5);
  }

  .primary-nav a {
    color: var(--color-text);
    font-size: 0.92rem;
    font-weight: 500;
    padding: var(--space-2) 0;
    position: relative;
    transition: color 0.15s ease;
  }

  .primary-nav a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .primary-nav a[aria-current='page'] {
    color: var(--color-accent);
  }

  .primary-nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    background: var(--color-accent);
  }

  .nav-toggle {
    display: none;
    background: transparent;
    border: 0;
    width: 40px;
    height: 40px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    cursor: pointer;
  }

  .nav-toggle span {
    width: 22px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }

  @media (max-width: 820px) {
    .nav-toggle { display: flex; }
    .header-search { display: none; }
    .header-search-link { display: inline-flex; }

    .primary-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-bg);
      border-bottom: 1px solid var(--color-border);
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.25s ease;
    }

    .primary-nav[data-open='true'] {
      max-height: 60vh;
      box-shadow: var(--shadow-md);
    }

    .primary-nav ul {
      flex-direction: column;
      gap: 0;
      padding: var(--space-3) 0;
    }

    .primary-nav li {
      border-top: 1px solid var(--color-border);
    }

    .primary-nav li:first-child { border-top: 0; }

    .primary-nav a {
      display: block;
      padding: var(--space-4) var(--space-5);
    }
  }
</style>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.getElementById('primary-nav');
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = nav.getAttribute('data-open') === 'true';
      nav.setAttribute('data-open', String(!open));
      toggle.setAttribute('aria-expanded', String(!open));
    });
  }
</script>
