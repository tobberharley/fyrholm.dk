---
interface Props {
  slug: string;
  size?: number;
  class?: string;
}

const { slug, size = 64, class: className = '' } = Astro.props;

// Icons are stroke-based (1.5px) and render in currentColor, so they inherit
// whatever colour their wrapper sets. Keep them simple and architectural.
const icons: Record<string, string> = {
  affaldssortering: `
    <rect x="6" y="14" width="36" height="30" rx="3" />
    <path d="M6 22 H42" />
    <path d="M18 14 V8 H30 V14" />
    <path d="M16 28 V38 M24 28 V38 M32 28 V38" />
  `,
  'akutte-skader': `
    <path d="M24 6 L6 40 H42 Z" />
    <path d="M24 18 V28" />
    <circle cx="24" cy="34" r="1.5" fill="currentColor" stroke="none" />
  `,
  beredskabsplan: `
    <path d="M24 6 L8 12 V24 C8 33 14 40 24 44 C34 40 40 33 40 24 V12 Z" />
    <path d="M18 24 L22 28 L31 18" />
  `,
  cykler: `
    <circle cx="12" cy="32" r="8" />
    <circle cx="36" cy="32" r="8" />
    <path d="M12 32 L20 18 H30 L36 32" />
    <path d="M22 18 L26 8 H30" />
    <path d="M16 14 H22" />
  `,
  flytning: `
    <rect x="4" y="18" width="22" height="18" rx="1" />
    <path d="M26 22 H38 L44 30 V36 H26 Z" />
    <circle cx="14" cy="38" r="3" />
    <circle cx="34" cy="38" r="3" />
    <path d="M10 18 V14 H22 V18" />
  `,
  'forslag-generalforsamling': `
    <rect x="8" y="8" width="32" height="32" rx="2" />
    <path d="M14 18 H34 M14 24 H34 M14 30 H26" />
  `,
  parkering: `
    <rect x="8" y="8" width="32" height="32" rx="3" />
    <path d="M19 32 V16 H26 C29 16 31 18 31 21 C31 24 29 26 26 26 H19" />
  `,
  'tv-internet-telefoni': `
    <rect x="6" y="12" width="36" height="22" rx="2" />
    <path d="M16 40 H32" />
    <path d="M24 34 V40" />
    <path d="M16 22 C20 18 28 18 32 22" />
    <path d="M19 26 C22 23 26 23 29 26" />
    <circle cx="24" cy="29" r="1.5" fill="currentColor" stroke="none" />
  `,
  'vinduer-doere': `
    <rect x="8" y="6" width="32" height="36" rx="1" />
    <path d="M24 6 V42" />
    <path d="M8 24 H40" />
    <circle cx="20" cy="24" r="1" fill="currentColor" stroke="none" />
    <circle cx="28" cy="24" r="1" fill="currentColor" stroke="none" />
  `,
};

const path = icons[slug] ?? `<circle cx="24" cy="24" r="16" />`;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 48 48"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={path}
/>
