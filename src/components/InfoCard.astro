---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { link } from '../lib/url';
import InfoIcon from './InfoIcon.astro';

interface Props {
  entry: CollectionEntry<'info'>;
}

const { entry } = Astro.props;
const href = link(`/viden/${entry.id}`);
const date = new Intl.DateTimeFormat('da-DK', {
  day: 'numeric', month: 'short', year: 'numeric',
}).format(entry.data.date);
---

<a class="info-card card" href={href}>
  <div class="card-image">
    {entry.data.image ? (
      <Image src={entry.data.image} alt={entry.data.imageAlt ?? ''} width={600} height={400} />
    ) : (
      <div class="info-icon-frame">
        <InfoIcon slug={entry.id} size={72} />
      </div>
    )}
  </div>
  <div class="card-body">
    <span class="eyebrow small">{entry.data.category}</span>
    <h3>{entry.data.title}</h3>
    <time datetime={entry.data.date.toISOString()} class="meta">{date}</time>
  </div>
</a>

<style>
  .info-card { text-decoration: none; color: inherit; }
  .info-card:hover { text-decoration: none; }
  .info-card h3 { margin: var(--space-2) 0; font-size: 1.15rem; }
  .meta { color: var(--color-text-muted); font-size: 0.85rem; margin-top: auto; }
  .eyebrow.small { font-size: 0.7rem; margin: 0; }

  .info-icon-frame {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background:
      linear-gradient(135deg, var(--color-bg-soft) 0%, var(--color-bg-muted) 100%);
    color: var(--color-accent);
  }
  .info-card:hover .info-icon-frame {
    background:
      linear-gradient(135deg, var(--color-bg-muted) 0%, var(--color-accent-soft) 100%);
  }
</style>
