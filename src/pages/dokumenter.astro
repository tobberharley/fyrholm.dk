---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { link } from '../lib/url';

const docs = (await getCollection('documents'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const groups: { id: string; label: string; categories: string[] }[] = [
  { id: 'generalforsamling', label: 'Generalforsamling', categories: ['generalforsamling-indkaldelse', 'generalforsamling-referat'] },
  { id: 'regnskab', label: 'Regnskab', categories: ['regnskab'] },
  { id: 'vedtaegter', label: 'Vedtægter', categories: ['vedtaegter'] },
  { id: 'husorden', label: 'Husorden', categories: ['husorden'] },
];

const fmt = new Intl.DateTimeFormat('da-DK', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Base title="Dokumenter" description="Vedtægter, husorden, generalforsamlingsdokumenter og regnskaber for Ejerforeningen Fyrholm.">
  <section class="section">
    <div class="container">
      <span class="eyebrow">Dokumenter</span>
      <h1>Foreningens dokumenter</h1>
      <p class="lead">
        Her finder du foreningens vedtægter, husorden, indkaldelser og referater fra generalforsamlinger samt regnskaber.
      </p>
      <p class="note">
        Bemærk: Bestyrelsesreferater er <strong>ikke</strong> offentligt tilgængelige.
      </p>

      <nav class="doc-toc" aria-label="Dokument-kategorier">
        {groups.map((g) => <a href={`#${g.id}`}>{g.label}</a>)}
      </nav>

      {groups.map((g) => {
        const items = docs.filter((d) => g.categories.includes(d.data.category));
        if (items.length === 0) return null;
        return (
          <section id={g.id} class="doc-group">
            <h2>{g.label}</h2>
            <ul class="doc-list">
              {items.map((d) => (
                <li>
                  <a href={link(d.data.file)} class="doc-link" target="_blank" rel="noopener">
                    <span class="doc-icon" aria-hidden="true">PDF</span>
                    <span class="doc-meta">
                      <span class="doc-title">{d.data.title}</span>
                      <span class="doc-date">{fmt.format(d.data.date)}</span>
                      {d.data.summary && <span class="doc-summary">{d.data.summary}</span>}
                    </span>
                    <span class="doc-action" aria-hidden="true">↓</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        );
      })}

      {docs.length === 0 && <p>Der er endnu ingen dokumenter publiceret.</p>}
    </div>
  </section>
</Base>

<style>
  .lead { color: var(--color-text-muted); max-width: 60ch; font-size: 1.1rem; }

  .note {
    background: var(--color-bg-soft);
    border-left: 4px solid var(--color-accent);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    margin: var(--space-5) 0;
    max-width: 60ch;
  }

  .doc-toc {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-6) 0 var(--space-7);
  }

  .doc-toc a {
    padding: var(--space-2) var(--space-4);
    background: var(--color-bg-soft);
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .doc-toc a:hover {
    background: var(--color-accent-soft);
    text-decoration: none;
  }

  .doc-group { margin-bottom: var(--space-7); scroll-margin-top: 80px; }

  .doc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .doc-link {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: inherit;
    transition: background 0.15s, border-color 0.15s;
  }

  .doc-link:hover {
    background: var(--color-bg-soft);
    border-color: var(--color-accent);
    text-decoration: none;
  }

  .doc-icon {
    flex: 0 0 56px;
    height: 56px;
    border-radius: var(--radius-sm);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
  }

  .doc-meta {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .doc-title { font-weight: 600; }
  .doc-date { font-size: 0.85rem; color: var(--color-text-muted); }
  .doc-summary { font-size: 0.9rem; color: var(--color-text-muted); margin-top: var(--space-1); }

  .doc-action {
    color: var(--color-accent);
    font-size: 1.4rem;
    font-weight: 700;
  }
</style>
