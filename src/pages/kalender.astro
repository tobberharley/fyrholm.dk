---
import Base from '../layouts/Base.astro';
import EventList from '../components/EventList.astro';
import { getCollection } from 'astro:content';
import { link } from '../lib/url';

const now = new Date();
now.setHours(0, 0, 0, 0);

const all = await getCollection('events');
const upcoming = all
  .filter((e) => (e.data.endDate ?? e.data.date) >= now)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const past = all
  .filter((e) => (e.data.endDate ?? e.data.date) < now)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 10);

// Webcal-URL til abonnement. Apple Kalender og Outlook åbner direkte.
// Android / Google Kalender kræver at man indsætter https-URL'en manuelt.
const icsPath = link('/kalender.ics');
const httpsUrl = `https://tobberharley.github.io${icsPath}`;
const webcalUrl = `webcal://tobberharley.github.io${icsPath}`;
// Google Kalender "render"-link åbner direkte add-by-URL-flowet (web/Android-app).
const googleAddUrl = `https://calendar.google.com/calendar/u/0/r?cid=${encodeURIComponent(httpsUrl)}`;
---

<Base title="Det sker" description="Begivenheder og arrangementer i Ejerforeningen Fyrholm.">
  <section class="section">
    <div class="container">
      <span class="eyebrow">Det sker</span>
      <h1>Kalender</h1>

      <div class="cal-subscribe" data-https-url={httpsUrl} data-webcal-url={webcalUrl} data-google-url={googleAddUrl}>
        <div class="cal-subscribe-text">
          <strong>Tilføj kalenderen til din telefon</strong>
          <p>Abonnér én gang og få nye begivenheder automatisk i din egen kalender.</p>
        </div>
        <div class="cal-subscribe-actions">
          <a class="btn cal-primary" href={webcalUrl} data-platform="auto">📅 Tilføj til kalender</a>
          <a class="cal-link" href={icsPath} download>Hent .ics-fil</a>
        </div>

        <p class="cal-platform-hint" hidden></p>

        <div class="cal-url">
          <label for="cal-url-input">Eller kopiér kalender-URL'en</label>
          <div class="cal-url-row">
            <input id="cal-url-input" type="text" readonly value={httpsUrl} />
            <button type="button" class="btn btn-secondary cal-copy" data-url={httpsUrl}>Kopiér</button>
          </div>
        </div>

        <details class="cal-help">
          <summary>Hjælp til andre kalendere</summary>
          <div class="cal-help-grid">
            <div>
              <strong>iPhone / iPad / Mac</strong>
              <p>Tryk på <em>📅 Tilføj til kalender</em> — Apple Kalender åbner og foreslår abonnement.</p>
            </div>
            <div>
              <strong>Google Kalender (Android / web)</strong>
              <p>Tryk på <em>📅 Tilføj til kalender</em> for at åbne Google Kalender direkte. Eller kopiér URL'en og indsæt under <em>Andre kalendere → Fra URL</em>.</p>
            </div>
            <div>
              <strong>Outlook</strong>
              <p>Indsæt URL'en under <em>Tilføj kalender → Abonnér fra web</em>.</p>
            </div>
          </div>
        </details>
      </div>

      <h2 style="margin-top: var(--space-6);">Kommende</h2>
      <EventList events={upcoming} />

      {past.length > 0 && (
        <>
          <h2 style="margin-top: var(--space-7);">Tidligere</h2>
          <EventList events={past} />
        </>
      )}
    </div>
  </section>
</Base>

<script>
  // Tilpas "Tilføj til kalender"-knappen til klientens platform.
  // Standard er webcal:// (virker for Apple Kalender og Outlook).
  // På Android peger vi i stedet på Google Kalender's add-by-URL-flow,
  // og på Windows/Linux uden tydelig handler beholder vi webcal som best-effort
  // og viser et hint om at man kan kopiere URL'en hvis intet sker.
  (function () {
    const wrap = document.querySelector<HTMLElement>('.cal-subscribe');
    if (!wrap) return;
    const primary = wrap.querySelector<HTMLAnchorElement>('.cal-primary');
    const hint = wrap.querySelector<HTMLParagraphElement>('.cal-platform-hint');
    if (!primary || !hint) return;

    const ua = navigator.userAgent;
    const platform = (navigator as any).userAgentData?.platform || navigator.platform || '';
    const isAndroid = /Android/i.test(ua);
    const isApple = /Mac|iPhone|iPad|iPod/i.test(platform) || /iPhone|iPad|iPod/i.test(ua);
    const isWindows = /Win/i.test(platform);

    const googleUrl = wrap.dataset.googleUrl!;
    const webcalUrl = wrap.dataset.webcalUrl!;

    if (isAndroid) {
      primary.href = googleUrl;
      primary.target = '_blank';
      primary.rel = 'noopener';
      primary.textContent = '📅 Føj til Google Kalender';
      hint.textContent = 'Åbner Google Kalender. Bekræft abonnementet og kalenderen synkroniseres til din telefon.';
      hint.hidden = false;
    } else if (isApple) {
      primary.href = webcalUrl;
      hint.textContent = 'Åbner Apple Kalender og foreslår abonnement.';
      hint.hidden = false;
    } else if (isWindows) {
      primary.href = webcalUrl;
      hint.textContent = "Åbner din standardkalender (fx Outlook). Hvis intet sker, kan du kopiere URL'en nedenfor.";
      hint.hidden = false;
    } else {
      primary.href = webcalUrl;
      hint.textContent = "Hvis ingen kalender åbner, så kopiér URL'en nedenfor og indsæt den i din kalender-app.";
      hint.hidden = false;
    }
  })();

  // Klik-til-kopier af kalender-URL.
  document.querySelectorAll<HTMLButtonElement>('.cal-copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.dataset.url || '';
      const original = btn.textContent;
      try {
        await navigator.clipboard.writeText(url);
        btn.textContent = 'Kopieret ✓';
      } catch {
        // Fallback: vælg input-feltets indhold
        const input = btn.parentElement?.querySelector<HTMLInputElement>('input');
        input?.select();
        document.execCommand?.('copy');
        btn.textContent = 'Kopieret ✓';
      }
      window.setTimeout(() => { btn.textContent = original; }, 1800);
    });
  });
</script>

<style>
  .cal-subscribe {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-5);
    align-items: flex-start;
    padding: var(--space-5);
    margin-top: var(--space-5);
    background: var(--color-accent-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .cal-subscribe-text { flex: 1 1 320px; min-width: 0; }
  .cal-subscribe-text strong {
    display: block;
    font-size: 1.05rem;
    margin-bottom: 0.25rem;
  }
  .cal-subscribe-text p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }
  .cal-subscribe-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }
  .cal-link {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .cal-platform-hint {
    flex: 1 1 100%;
    margin: 0;
    font-size: 0.88rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .cal-url {
    flex: 1 1 100%;
    margin-top: var(--space-2);
  }
  .cal-url label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }
  .cal-url-row {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .cal-url-row input {
    flex: 1 1 280px;
    min-width: 0;
    padding: 0.5rem 0.75rem;
    font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, monospace;
    font-size: 0.85rem;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text);
  }
  .cal-copy { white-space: nowrap; }

  .cal-help {
    flex: 1 1 100%;
    margin-top: var(--space-2);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-4);
  }
  .cal-help summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--color-accent);
  }
  .cal-help[open] summary { margin-bottom: var(--space-3); }
  .cal-help-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .cal-help-grid strong {
    display: block;
    font-size: 0.95rem;
    margin-bottom: 0.25rem;
  }
  .cal-help-grid p,
  .cal-help-grid ol {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .cal-help-grid ol { padding-left: 1.2rem; }
</style>
