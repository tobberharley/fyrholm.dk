---
import Base from '../../layouts/Base.astro';
import NewsCard from '../../components/NewsCard.astro';
import { getCollection } from 'astro:content';
import { link } from '../../lib/url';

const news = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="Nyheder" description="Seneste nyheder fra Ejerforeningen Fyrholm.">
  <section class="section">
    <div class="container">
      <span class="eyebrow">Nyheder</span>
      <div class="news-header">
        <h1>Seneste nyt fra foreningen</h1>
        <a class="rss-link" href={link('/rss.xml')} aria-label="Abonnér på nyheder via RSS">
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
            <path d="M6.18 17.82a2.18 2.18 0 1 1-4.36 0 2.18 2.18 0 0 1 4.36 0zM4 4.44v3.1c7.03 0 12.73 5.7 12.73 12.73h3.1C19.83 11.36 12.91 4.44 4 4.44zm0 5.82v3.1A6.91 6.91 0 0 1 10.91 20.27h3.1A10.01 10.01 0 0 0 4 10.26z"/>
          </svg>
          <span>RSS</span>
        </a>
      </div>
      <p class="lead">Følg med via RSS — kopiér linket <code>{link('/rss.xml')}</code> ind i din feed-læser.</p>
      {news.length === 0 ? (
        <p>Der er endnu ingen nyheder publiceret.</p>
      ) : (
        <div class="grid grid-3" style="margin-top: var(--space-6);">
          {news.map((entry) => <NewsCard entry={entry} />)}
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .news-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }
  .news-header h1 { margin: 0; }
  .rss-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #ee802f;
    color: #fff;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }
  .rss-link:hover { background: #d96f1f; text-decoration: none; }
  .lead code {
    background: rgba(0,0,0,0.06);
    padding: 0.1em 0.4em;
    border-radius: 4px;
    font-size: 0.9em;
  }
</style>
