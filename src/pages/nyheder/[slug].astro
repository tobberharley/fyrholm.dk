---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const items = await getCollection('news', ({ data }) => !data.draft);
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const formatted = new Intl.DateTimeFormat('da-DK', {
  day: 'numeric', month: 'long', year: 'numeric',
}).format(entry.data.date);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <article class="section">
    <div class="container-narrow">
      <a href="/nyheder" class="back">← Alle nyheder</a>
      <span class="eyebrow">Nyhed</span>
      <h1>{entry.data.title}</h1>
      <p class="meta"><time datetime={entry.data.date.toISOString()}>{formatted}</time></p>
      {entry.data.image && (
        <Image src={entry.data.image} alt={entry.data.imageAlt ?? ''} width={1200} height={680} class="hero-image" />
      )}
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  .back {
    display: inline-block;
    margin-bottom: var(--space-4);
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }
  .meta {
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }
  .hero-image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-6);
  }
</style>
