---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import NewsCard from '../components/NewsCard.astro';
import InfoCard from '../components/InfoCard.astro';
import EventList from '../components/EventList.astro';
import LocationMap from '../components/LocationMap.astro';
import FacilityCard from '../components/FacilityCard.astro';
import { getCollection } from 'astro:content';
import { link } from '../lib/url';

const news = (await getCollection('news', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

const now = new Date();
const events = (await getCollection('events'))
  .filter((e) => (e.data.endDate ?? e.data.date) >= now)
  .sort((a, b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0, 4);

const info = (await getCollection('info'))
  .sort((a, b) => a.data.order - b.data.order || b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const facilities = (await getCollection('facilities'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);
---

<Base>
  <Hero />

  <section class="showcase" aria-label="Fyrholm set fra havneløbet">
    <img
      src={link('/images/fyrholm-cfmoller.jpg')}
      alt="Fyrholm-karréen set fra havneløbet på Sluseholmen"
      loading="lazy"
      width="1800"
      height="1351"
    />
    <div class="showcase-overlay">
      <div class="container">
        <span class="eyebrow">Om bygningen</span>
        <h2>En hollandsk-inspireret karré ved kanalerne</h2>
        <p>
          Fyrholm stod færdig i 2006 efter en helhedsplan af den hollandske arkitekt Sjoerd Soeters
          — en moderne fortolkning af Amsterdams gårdkvarterer, tegnet af blandt andre C.F. Møller
          og Gröning Arkitekter.
        </p>
        <a href={link('/historie')} class="btn">Læs historien</a>
      </div>
    </div>
    <p class="showcase-credit">Foto: C.F. Møller Architects</p>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="eyebrow">Seneste nyheder</span>
          <h2>Nyt fra foreningen</h2>
        </div>
        <a href={link('/nyheder')} class="btn btn-secondary">Se alle nyheder</a>
      </div>
      {news.length === 0 ? (
        <p>Der er endnu ingen nyheder. Kig forbi igen snart!</p>
      ) : (
        <div class="grid grid-3">
          {news.map((entry) => <NewsCard entry={entry} />)}
        </div>
      )}
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="eyebrow">Det sker</span>
          <h2>Kom og mød dine naboer</h2>
        </div>
        <a href={link('/kalender')} class="btn btn-secondary">Se kalenderen</a>
      </div>
      <EventList events={events} />
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="eyebrow">Faciliteter og laug</span>
          <h2>Mere end fire vægge</h2>
        </div>
        <a href={link('/faciliteter')} class="btn btn-secondary">Se alle faciliteter</a>
      </div>
      <div class="grid grid-3">
        {facilities.map((entry) => <FacilityCard entry={entry} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="eyebrow">Mest læste</span>
          <h2>Godt at vide</h2>
        </div>
        <a href={link('/viden')} class="btn btn-secondary">Se al beboerinfo</a>
      </div>
      {info.length === 0 ? (
        <p>Beboerinfo er på vej.</p>
      ) : (
        <div class="grid grid-4">
          {info.map((entry) => <InfoCard entry={entry} />)}
        </div>
      )}
    </div>
  </section>

  <section class="section section-muted">
    <div class="container cta-row">
      <div>
        <span class="eyebrow">Ny beboer</span>
        <h2>Velkommen til Fyrholm</h2>
        <p>Vi har samlet alt det, du som beboer eller tilflytter har brug for, for at blive en del af fællesskabet.</p>
      </div>
      <a href={link('/ny-beboer')} class="btn">Start her</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <span class="eyebrow">Find vej</span>
          <h2>Sådan ligger vi</h2>
        </div>
        <a href={link('/kontakt')} class="btn btn-secondary">Kontakt os</a>
      </div>
      <LocationMap />
    </div>
  </section>

  <section class="section">

  .showcase {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .showcase img {
    display: block;
    width: 100%;
    height: clamp(360px, 60vh, 640px);
    object-fit: cover;
    object-position: center 55%;
  }
  .showcase-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding-bottom: var(--space-8);
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.78) 0%,
      rgba(0, 0, 0, 0.55) 35%,
      rgba(0, 0, 0, 0.15) 65%,
      rgba(0, 0, 0, 0) 100%
    );
    color: #fff;
  }
  .showcase-overlay .eyebrow {
    color: rgba(255, 255, 255, 0.85);
  }
  .showcase-overlay h2 {
    color: #fff;
    margin: var(--space-2) 0 var(--space-3);
    max-width: 22ch;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.15;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.35);
  }
  .showcase-overlay p {
    color: rgba(255, 255, 255, 0.92);
    max-width: 60ch;
    margin: 0 0 var(--space-5);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.35);
  }
  .showcase-credit {
    position: absolute;
    right: var(--space-4);
    top: var(--space-3);
    margin: 0;
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.75);
    background: rgba(0, 0, 0, 0.35);
    padding: 4px 10px;
    border-radius: 999px;
    letter-spacing: 0.02em;
  }
  @media (max-width: 640px) {
    .showcase img { height: 420px; }
    .showcase-overlay { padding-bottom: var(--space-6); }
  }
    <div class="container cta-row">
      <div>
        <span class="eyebrow">Kontakt os</span>
        <h2>Har du spørgsmål?</h2>
        <p>Skriv til os, eller find kontaktinfo til bestyrelse og administration.</p>
      </div>
      <a href={link('/kontakt')} class="btn">Kontakt os</a>
    </div>
  </section>
</Base>

<style>
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-5);
  }

  .cta-row > div { max-width: 60ch; }
  .cta-row h2 { margin: var(--space-2) 0 var(--space-3); }
  .cta-row p { color: var(--color-text-muted); margin: 0; }
</style>
