---
import Base from '../../layouts/Base.astro';
import { link } from '../../lib/url';

interface Topic {
  slug: string;
  title: string;
  icon: string;
  summary: string;
  href: string;
  external?: boolean;
}

const topics: Topic[] = [
  {
    slug: 'bestyrelsen',
    title: 'Bestyrelsen',
    icon: '👥',
    summary: 'Mød bestyrelsen og find kontaktoplysninger til formand og medlemmer.',
    href: '/kontakt#bestyrelsen',
  },
  {
    slug: 'administrator',
    title: 'Administrator',
    icon: '🏢',
    summary: 'Administration Danmark v/Tina Jørgensen håndterer økonomi, fællesudgifter og daglig drift.',
    href: '/kontakt#administrator',
  },
  {
    slug: 'generalforsamling',
    title: 'Generalforsamling',
    icon: '📋',
    summary: 'Indkaldelser, dagsorden og referater fra ordinære og ekstraordinære generalforsamlinger.',
    href: '/ejerforeningen/generalforsamling',
  },
  {
    slug: 'vedtaegter',
    title: 'Vedtægter',
    icon: '📜',
    summary: 'Foreningens vedtægter — det juridiske grundlag for ejerforeningen.',
    href: '/ejerforeningen/vedtaegter',
  },
  {
    slug: 'husorden',
    title: 'Husorden og ordensregler',
    icon: '🏠',
    summary: 'Husorden, ordensregler for cykler og orangeri — sådan bor vi sammen i Fyrholm.',
    href: '/ejerforeningen/husorden',
  },
  {
    slug: 'regnskab',
    title: 'Regnskab og budget',
    icon: '💰',
    summary: 'Årsrapporter og driftsbudgetter for de seneste år.',
    href: '/ejerforeningen/regnskab',
  },
];
---

<Base title="Ejerforeningen" description="Bestyrelsen, administrator, generalforsamling, vedtægter, husorden, regnskab og øvrige dokumenter for Ejerforeningen Fyrholm.">
  <section class="section">
    <div class="container">
      <span class="eyebrow">Ejerforeningen</span>
      <h1>Foreningen og dens dokumenter</h1>
      <p class="lead">
        Her finder du alt om Ejerforeningen Fyrholm — bestyrelsen, administrator,
        generalforsamlingsdokumenter, vedtægter, husorden og regnskaber.
      </p>
      <p class="note">
        Bemærk: Bestyrelsesreferater er <strong>ikke</strong> offentligt tilgængelige.
      </p>

      <div class="grid grid-3" style="margin-top: var(--space-7);">
        {topics.map((t) => (
          <a class="topic-card card" href={link(t.href)}>
            <div class="topic-icon" aria-hidden="true">{t.icon}</div>
            <div class="topic-body">
              <h3>{t.title}</h3>
              <p>{t.summary}</p>
              <span class="topic-link">Læs mere →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .lead { color: var(--color-text-muted); max-width: 60ch; font-size: 1.1rem; }

  .note {
    background: var(--color-bg-soft);
    border-left: 4px solid var(--color-accent);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    margin: var(--space-5) 0;
    max-width: 60ch;
  }

  .topic-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .topic-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-accent);
    text-decoration: none;
  }
  .topic-icon {
    font-size: 2rem;
    line-height: 1;
    width: 3rem;
    height: 3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    background: var(--color-accent-soft, var(--color-bg-soft));
  }
  .topic-body h3 {
    margin: 0 0 var(--space-2);
  }
  .topic-body p {
    margin: 0 0 var(--space-3);
    color: var(--color-text-muted);
  }
  .topic-link {
    color: var(--color-accent);
    font-weight: 600;
    margin-top: auto;
  }
</style>
