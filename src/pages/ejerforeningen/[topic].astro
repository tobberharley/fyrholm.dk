---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { link } from '../../lib/url';

interface TopicConfig {
  title: string;
  description: string;
  intro: string;
  categories: string[];
  emptyText?: string;
}

const topics: Record<string, TopicConfig> = {
  generalforsamling: {
    title: 'Generalforsamling',
    description: 'Indkaldelser, dagsorden og referater fra Ejerforeningen Fyrholms generalforsamlinger.',
    intro: 'Den ordinære generalforsamling afholdes hvert år. Her finder du indkaldelser med dagsorden samt referater fra de senest afholdte generalforsamlinger.',
    categories: ['generalforsamling-indkaldelse', 'generalforsamling-referat'],
    emptyText: 'Der er endnu ikke offentliggjort generalforsamlingsdokumenter.',
  },
  vedtaegter: {
    title: 'Vedtægter',
    description: 'Foreningens vedtægter — det juridiske grundlag for Ejerforeningen Fyrholm.',
    intro: 'Vedtægterne er det juridiske grundlag for foreningen og kan kun ændres på en generalforsamling. Den nyeste vedtagne version findes nedenfor.',
    categories: ['vedtaegter'],
    emptyText: 'Vedtægter er ikke uploadet endnu.',
  },
  husorden: {
    title: 'Husorden og ordensregler',
    description: 'Husorden samt ordensregler for cykler og orangeri i Ejerforeningen Fyrholm.',
    intro: 'Husordenen beskriver retningslinjer for, hvordan vi bor og lever sammen på Fyrholm. Herudover findes specifikke ordensregler for cykler og foreningens orangeri.',
    categories: ['husorden'],
    emptyText: 'Husorden er ikke uploadet endnu.',
  },
  regnskab: {
    title: 'Regnskab og budget',
    description: 'Årsrapporter og driftsbudgetter for Ejerforeningen Fyrholm.',
    intro: 'Foreningens revisorgodkendte årsrapporter og de af generalforsamlingen vedtagne driftsbudgetter. Sorteret med nyeste øverst.',
    categories: ['regnskab'],
    emptyText: 'Regnskaber og budgetter er ikke uploadet endnu.',
  },
};

export async function getStaticPaths() {
  return [
    { params: { topic: 'generalforsamling' } },
    { params: { topic: 'vedtaegter' } },
    { params: { topic: 'husorden' } },
    { params: { topic: 'regnskab' } },
  ];
}

const { topic } = Astro.params;
const config = topics[topic as string];
if (!config) {
  throw new Error(`Unknown ejerforeningen topic: ${topic}`);
}

const docs = (await getCollection('documents'))
  .filter((d) => config.categories.includes(d.data.category))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const fmt = new Intl.DateTimeFormat('da-DK', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Base title={config.title} description={config.description}>
  <section class="section">
    <div class="container-narrow">
      <p class="back"><a href={link('/ejerforeningen')}>← Tilbage til Ejerforeningen</a></p>
      <span class="eyebrow">Ejerforeningen</span>
      <h1>{config.title}</h1>
      <p class="lead">{config.intro}</p>

      {docs.length === 0 ? (
        <p class="empty">{config.emptyText}</p>
      ) : (
        <ul class="doc-list">
          {docs.map((d) => (
            <li>
              <a href={link(d.data.file)} class="doc-link" target="_blank" rel="noopener">
                <span class="doc-icon" aria-hidden="true">PDF</span>
                <span class="doc-meta">
                  <span class="doc-title">{d.data.title}</span>
                  <span class="doc-date">{fmt.format(d.data.date)}</span>
                  {d.data.summary && <span class="doc-summary">{d.data.summary}</span>}
                </span>
                <span class="doc-action" aria-hidden="true">↓</span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Base>

<style>
  .back { margin-bottom: var(--space-4); font-size: 0.95rem; }
  .lead { color: var(--color-text-muted); font-size: 1.1rem; }
  .empty { color: var(--color-text-muted); font-style: italic; }

  .doc-list {
    list-style: none;
    margin: var(--space-7) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .doc-link {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: inherit;
    transition: background 0.15s, border-color 0.15s;
  }
  .doc-link:hover {
    background: var(--color-bg-soft);
    border-color: var(--color-accent);
    text-decoration: none;
  }
  .doc-icon {
    flex: 0 0 56px;
    height: 56px;
    border-radius: var(--radius-sm);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
  }
  .doc-meta {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .doc-title { font-weight: 600; }
  .doc-date { font-size: 0.85rem; color: var(--color-text-muted); }
  .doc-summary { font-size: 0.9rem; color: var(--color-text-muted); margin-top: var(--space-1); }
  .doc-action { color: var(--color-accent); font-size: 1.4rem; font-weight: 700; }
</style>
