---
import Base from '../layouts/Base.astro';
import { base } from '../lib/url';
---

<Base title="Søg" description="Søg på Ejerforeningen Fyrholms hjemmeside.">
  <section class="section">
    <div class="container-narrow">
      <span class="eyebrow">Søg</span>
      <h1>Find det du leder efter</h1>
      <p class="lead">Søg blandt nyheder, beboerinfo og dokumenter.</p>

      <div id="search"></div>
    </div>
  </section>

  <link href={`${base}/pagefind/pagefind-ui.css`} rel="stylesheet" />
  <script src={`${base}/pagefind/pagefind-ui.js`} is:inline></script>
  <script is:inline define:vars={{ pagefindBase: `${base}/pagefind/`, basePath: base }}>
    window.addEventListener('DOMContentLoaded', () => {
      const params = new URLSearchParams(window.location.search);
      const initial = params.get('q') ?? '';
      const isEn = location.pathname === `${basePath}/en` || location.pathname.indexOf(`${basePath}/en/`) === 0;
      const translations = isEn
        ? {
            placeholder: 'Search…',
            clear_search: 'Clear',
            load_more: 'Load more',
            search_label: 'Search',
            filters_label: 'Filters',
            zero_results: 'No results for [SEARCH_TERM]',
            many_results: '[COUNT] results for [SEARCH_TERM]',
            one_result: '[COUNT] result for [SEARCH_TERM]',
            alt_search: 'No results for [SEARCH_TERM]. Showing results for [DIFFERENT_TERM]',
            search_suggestion: 'No results for [SEARCH_TERM]. Try one of these searches:',
            searching: 'Searching for [SEARCH_TERM]…'
          }
        : {
            placeholder: 'Søg…',
            clear_search: 'Ryd',
            load_more: 'Vis flere',
            search_label: 'Søg',
            filters_label: 'Filtre',
            zero_results: 'Ingen resultater for [SEARCH_TERM]',
            many_results: '[COUNT] resultater for [SEARCH_TERM]',
            one_result: '[COUNT] resultat for [SEARCH_TERM]',
            alt_search: 'Ingen resultater for [SEARCH_TERM]. Viser resultater for [DIFFERENT_TERM]',
            search_suggestion: 'Ingen resultater for [SEARCH_TERM]. Prøv en af disse søgninger:',
            searching: 'Søger efter [SEARCH_TERM]…'
          };
      if (typeof PagefindUI !== 'undefined') {
        new PagefindUI({
          element: '#search',
          bundlePath: pagefindBase,
          showSubResults: true,
          showImages: false,
          translations
        });
        if (initial) {
          // Pagefind UI input gets created async; wait one tick.
          setTimeout(() => {
            const input = document.querySelector('#search input[type="text"]');
            if (input) {
              input.value = initial;
              input.dispatchEvent(new Event('input', { bubbles: true }));
            }
          }, 50);
        }
      } else {
        document.getElementById('search').innerHTML =
          '<p style="color: var(--color-text-muted)">Søgning er kun tilgængelig efter en produktions-build (<code>npm run build</code>).</p>';
      }
    });
  </script>
</Base>

<style is:global>
  .lead { color: var(--color-text-muted); font-size: 1.1rem; max-width: 60ch; }

  /* Pagefind UI customisation — match site tokens */
  :root {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--color-accent);
    --pagefind-ui-text: var(--color-text);
    --pagefind-ui-background: var(--color-bg);
    --pagefind-ui-border: var(--color-border);
    --pagefind-ui-tag: var(--color-bg-soft, #f1ede4);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 12px;
    --pagefind-ui-image-border-radius: 8px;
    --pagefind-ui-image-box-ratio: 3 / 2;
    --pagefind-ui-font: var(--font-sans);
  }

  .pagefind-ui {
    margin-top: var(--space-4);
  }

  .pagefind-ui__form::before {
    background-color: var(--color-text-muted) !important;
    opacity: 0.6;
  }

  .pagefind-ui__search-input {
    font-size: 1.05rem !important;
    padding: 0.9em 1em 0.9em 2.6em !important;
    border-radius: 12px !important;
    border-color: var(--color-border) !important;
    background: #fff !important;
    box-shadow: 0 1px 2px rgba(0,0,0,0.04);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .pagefind-ui__search-input:focus {
    outline: none;
    border-color: var(--color-accent) !important;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-accent) 25%, transparent);
  }

  .pagefind-ui__search-clear {
    color: var(--color-text-muted) !important;
    background: transparent !important;
    font-weight: 500;
  }
  .pagefind-ui__search-clear:hover {
    color: var(--color-accent) !important;
  }

  .pagefind-ui__message {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    border-top: none;
    padding: var(--space-4) 0 var(--space-2);
    margin: 0;
    font-weight: 500;
  }

  .pagefind-ui__results {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-2);
    padding: 0;
  }

  .pagefind-ui__result {
    border-top: none !important;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: var(--space-4) var(--space-5) !important;
    background: #fff;
    transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
  }
  .pagefind-ui__result:hover {
    border-color: var(--color-accent);
    box-shadow: 0 4px 14px rgba(0,0,0,0.06);
    transform: translateY(-1px);
  }

  .pagefind-ui__result-thumb { display: none !important; }
  .pagefind-ui__result-inner { gap: 0.4rem; }

  .pagefind-ui__result-title {
    font-size: 1.15rem !important;
    font-weight: 600 !important;
    line-height: 1.3 !important;
    margin-bottom: 0.25rem !important;
  }
  .pagefind-ui__result-title a {
    color: var(--color-text) !important;
    text-decoration: none !important;
  }
  .pagefind-ui__result-title a:hover {
    color: var(--color-accent) !important;
  }

  .pagefind-ui__result-excerpt {
    color: var(--color-text-muted) !important;
    font-size: 0.97rem !important;
    line-height: 1.55 !important;
  }

  .pagefind-ui__result mark,
  .pagefind-ui__result-excerpt mark {
    background: color-mix(in srgb, var(--color-accent) 18%, transparent) !important;
    color: var(--color-text) !important;
    font-weight: 600;
    padding: 0 2px;
    border-radius: 3px;
  }

  .pagefind-ui__result-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.5rem;
  }
  .pagefind-ui__result-tag {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    background: var(--color-bg-soft, #f1ede4);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-weight: 500;
  }

  .pagefind-ui__button {
    background: transparent !important;
    color: var(--color-accent) !important;
    border: 1px solid var(--color-border) !important;
    border-radius: 999px !important;
    padding: 0.55em 1.4em !important;
    font-weight: 500 !important;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .pagefind-ui__button:hover {
    background: var(--color-bg-soft, #f1ede4) !important;
    border-color: var(--color-accent) !important;
  }

  /* Sub-results (sections within a page) */
  .pagefind-ui__result-nested {
    margin-top: 0.6rem !important;
    padding: 0.4rem 0 0.4rem 0.9rem !important;
    border-left: 2px solid var(--color-border) !important;
  }
  .pagefind-ui__result-nested .pagefind-ui__result-title {
    font-size: 0.95rem !important;
    font-weight: 500 !important;
    margin-bottom: 0.15rem !important;
  }
  .pagefind-ui__result-nested .pagefind-ui__result-excerpt {
    font-size: 0.9rem !important;
  }

  /* Strip any leftover MyMemory placeholder tags that survived (defence-in-depth) */
  .pagefind-ui__result-title g,
  .pagefind-ui__result-excerpt g { display: contents; }
</style>
