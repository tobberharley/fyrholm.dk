---
import Base from '../layouts/Base.astro';
---

<Base title="Søg" description="Søg på Ejerforeningen Fyrholms hjemmeside.">
  <section class="section">
    <div class="container-narrow">
      <span class="eyebrow">Søg</span>
      <h1>Find det du leder efter</h1>
      <p class="lead">Søg blandt nyheder, beboerinfo og dokumenter.</p>

      <div id="search"></div>
    </div>
  </section>

  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script src="/pagefind/pagefind-ui.js" is:inline></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      const params = new URLSearchParams(window.location.search);
      const initial = params.get('q') ?? '';
      if (typeof PagefindUI !== 'undefined') {
        new PagefindUI({
          element: '#search',
          showSubResults: true,
          showImages: false,
          translations: {
            placeholder: 'Søg…',
            clear_search: 'Ryd',
            load_more: 'Vis flere',
            search_label: 'Søg',
            filters_label: 'Filtre',
            zero_results: 'Ingen resultater for [SEARCH_TERM]',
            many_results: '[COUNT] resultater for [SEARCH_TERM]',
            one_result: '[COUNT] resultat for [SEARCH_TERM]',
            alt_search: 'Ingen resultater for [SEARCH_TERM]. Viser resultater for [DIFFERENT_TERM]',
            search_suggestion: 'Ingen resultater for [SEARCH_TERM]. Prøv en af disse søgninger:',
            searching: 'Søger efter [SEARCH_TERM]…'
          }
        });
        if (initial) {
          // Pagefind UI input gets created async; wait one tick.
          setTimeout(() => {
            const input = document.querySelector('#search input[type="text"]');
            if (input) {
              input.value = initial;
              input.dispatchEvent(new Event('input', { bubbles: true }));
            }
          }, 50);
        }
      } else {
        document.getElementById('search').innerHTML =
          '<p style="color: var(--color-text-muted)">Søgning er kun tilgængelig efter en produktions-build (<code>npm run build</code>).</p>';
      }
    });
  </script>
</Base>

<style>
  .lead { color: var(--color-text-muted); font-size: 1.1rem; max-width: 60ch; }
</style>
