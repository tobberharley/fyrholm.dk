---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { link } from '../../lib/url';
import InfoIcon from '../../components/InfoIcon.astro';

export async function getStaticPaths() {
  const items = await getCollection('info');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <article class="section">
    <div class="container-narrow">
      <a href={link('/viden')} class="back">← Al beboerinfo</a>
      <div class="topic-icon" aria-hidden="true">
        <InfoIcon slug={entry.id} size={56} />
      </div>
      <span class="eyebrow">{entry.data.category}</span>
      <h1>{entry.data.title}</h1>
      {entry.data.image && (
        <Image src={entry.data.image} alt={entry.data.imageAlt ?? ''} width={1200} height={680} class="hero-image" />
      )}
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  .back {
    display: inline-block;
    margin-bottom: var(--space-4);
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }
  .topic-icon {
    width: 88px;
    height: 88px;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--color-bg-soft) 0%, var(--color-bg-muted) 100%);
    color: var(--color-accent);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-4);
  }
  .hero-image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    margin: var(--space-5) 0 var(--space-6);
  }
</style>
