---
import Base from '../../../layouts/Base.astro';
import { link } from '../../../lib/url';

const subject = encodeURIComponent('Opskrivning på venteliste — p-plads i Fyrholm');
const body = encodeURIComponent(
  [
    'Hej Administration Danmark',
    '',
    'Jeg vil gerne skrives op på ventelisten til en p-plads i Fyrholms parkeringskælder.',
    '',
    'Navn:',
    'Adresse (Fyrholm):',
    'Telefon:',
    'E-mail:',
    'Ønsker el-bil ladestander: ja/nej',
    '',
    'Venlig hilsen',
  ].join('\n')
);
const mailto = `mailto:venteliste@admdk.dk?subject=${subject}&body=${body}`;
---

<Base title="Lej en p-plads" description="Skriv dig op på ventelisten til en p-plads i Fyrholms parkeringskælder.">
  <article class="section">
    <div class="container-narrow">
      <p><a href={link('/faciliteter/parkeringskaelder')}>← Tilbage til Parkeringskælder</a></p>
      <span class="eyebrow">Leje</span>
      <h1>Lej en p-plads</h1>
      <p class="lead">
        P-pladser i Fyrholms underjordiske parkeringskælder udlejes via Administration Danmark.
        Der kan være venteliste i perioder — derfor anbefales det at skrive sig op i god tid.
      </p>

      <ol class="steps">
        <li>
          <strong>Send opskrivning til administrator</strong><br />
          Skriv en mail til <a href="mailto:venteliste@admdk.dk">venteliste@admdk.dk</a> med dit navn,
          adresse i Fyrholm, telefon, e-mail samt om du ønsker el-bil ladestander.
        </li>
        <li>
          <strong>Få bekræftelse</strong><br />
          Administration Danmark bekræfter din opskrivning og melder tilbage, når der er en ledig plads.
        </li>
        <li>
          <strong>Underskriv lejekontrakt</strong><br />
          Når du tilbydes en plads, sender administrator en lejekontrakt til underskrift.
        </li>
      </ol>

      <p class="cta-row">
        <a href={mailto} class="btn">Skriv mig op til ventelisten</a>
      </p>

      <h2>Vigtigt at vide</h2>
      <ul>
        <li>Pladserne udlejes <strong>kun til beboere</strong> i Fyrholm.</li>
        <li>Lejen opkræves sammen med fællesudgifterne.</li>
        <li>El-bil ladning afregnes særskilt efter forbrug.</li>
        <li>Generelle spørgsmål: <a href="mailto:adm@admdk.dk">adm@admdk.dk</a> · <a href="tel:+4570205957">7020 5957</a></li>
      </ul>

      <p style="margin-top: var(--space-6); color: var(--color-text-muted);">
        Se også <a href={link('/viden/parkering')}>Parkering</a> for info om gadeparkering, beboerlicens og cykelparkering.
      </p>
    </div>
  </article>
</Base>

<style>
  .lead { color: var(--color-text-muted); font-size: 1.15rem; max-width: 60ch; }
  .steps {
    margin: var(--space-7) 0;
    padding-left: 0;
    list-style: none;
    counter-reset: step;
    display: grid;
    gap: var(--space-4);
  }
  .steps li {
    counter-increment: step;
    padding: var(--space-4) var(--space-5) var(--space-4) calc(var(--space-5) + 2rem);
    background: var(--color-bg-soft);
    border-radius: var(--radius-md);
    position: relative;
  }
  .steps li::before {
    content: counter(step);
    position: absolute;
    left: var(--space-4);
    top: var(--space-4);
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--color-accent);
    color: #fff;
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 0.9rem;
  }
  .cta-row { margin-top: var(--space-6); }
</style>
