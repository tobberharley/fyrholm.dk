---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { link } from '../../lib/url';

export async function getStaticPaths() {
  const facilities = await getCollection('facilities');
  return facilities
    .filter((f) => !f.data.link) // external-link entries don't get their own page
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props as { entry: any };
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <article class="section">
    <div class="container-narrow">
      <p><a href={link('/faciliteter')}>← Alle faciliteter</a></p>
      <div class="facility-header">
        <span class="facility-icon" aria-hidden="true">{entry.data.icon}</span>
        <h1>{entry.data.title}</h1>
      </div>
      <p class="lead">{entry.data.summary}</p>
      {entry.data.image && (
        <figure class="facility-image">
          <img src={link(entry.data.image)} alt={entry.data.imageAlt ?? entry.data.title} loading="lazy" />
          {entry.data.imageCredit && <figcaption>Foto: {entry.data.imageCredit}</figcaption>}
        </figure>
      )}
      {entry.id === 'orangeriet' && (
        <p style="margin: var(--space-5) 0;">
          <a href={link('/faciliteter/orangeriet/book')} class="btn">Book Orangeriet →</a>
        </p>
      )}
      {entry.id === 'parkeringskaelder' && (
        <p style="margin: var(--space-5) 0;">
          <a href={link('/faciliteter/parkeringskaelder/lej')} class="btn">Lej en p-plads →</a>
        </p>
      )}
      <div class="prose"><Content /></div>
    </div>
  </article>
</Base>

<style>
  .facility-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }
  .facility-header h1 { margin: 0; }
  .facility-icon {
    font-size: 2.5rem;
    width: 3.5rem;
    height: 3.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    background: var(--color-bg-soft);
  }
  .lead { color: var(--color-text-muted); font-size: 1.15rem; }
  .facility-image {
    margin: var(--space-5) 0 var(--space-6);
  }
  .facility-image img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg, 12px);
    display: block;
  }
  .facility-image figcaption {
    margin-top: var(--space-2);
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-align: right;
  }
</style>
